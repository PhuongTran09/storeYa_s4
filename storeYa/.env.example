# Copy this file to storeYa/.env and fill in real values. .env is git-ignored.
#
# FORMAT: this is parsed as a Java properties file, not as a shell script.
#   KEY=value        correct
#   export KEY=value WRONG   (the word "export" becomes part of the key)
#   KEY="value"      WRONG   (the quotes become part of the value)
#   KEY = value      WRONG   (spaces around = are kept)
#
# WORKING DIRECTORY: application.properties imports `file:.env`, which is
# relative to the process working directory. Always launch the backend from
# storeYa/. In IntelliJ IDEA set Run Configuration -> Working directory to
# D:\PROJECT\storeYa_s4\storeYa, otherwise the app fails at startup with
# "Could not resolve placeholder 'DB_PASSWORD'".
#
# Real environment variables also satisfy these placeholders, so a container
# or CI system can set DB_PASSWORD directly and skip this file entirely.

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=training
DB_USERNAME=postgres
DB_PASSWORD=

*** Keycloak
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/training-realm
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=training-realm
KEYCLOAK_CLIENT_ID=training
KEYCLOAK_CLIENT_SECRET=

*** SMTP (OTP delivery)
MAIL_USERNAME=
MAIL_PASSWORD=

*** Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

*** VNPay
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

*** Optional overrides
CORS_ALLOWED_ORIGINS=http://localhost:4200
TRUST_PROXY=false
